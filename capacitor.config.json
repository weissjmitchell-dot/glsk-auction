{
  "appId": "com.mitchellweiss.glsk",
  "appName": "GLSK",
  "webDir": "dist-ios",
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#0b1220"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "server": {
    "appStartPath": "league.html"
  }
}
